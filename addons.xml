<?xml version="1.0" encoding="UTF-8"?>
<addons>
  <addon id="repository.JulioDev"
    name="JulioDev Repository"
    version="1.0.0"
    provider-name="JulioDev">
    <requires>
      <import addon="xbmc.addon" version="12.0.0" />
    </requires>
    <extension point="xbmc.addon.repository" name="JulioDev Repository">
      <dir minversion="19.0.0" maxversion="21.99.99">
        <info compressed="false">https://juliodev00.github.io/KodiRepo/addons.xml</info>
        <checksum>https://juliodev00.github.io/KodiRepo/addons.xml.md5.txt</checksum>
        <datadir zip="true">https://juliodev00.github.io/KodiRepo/zips/</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary>Repositorio oficial de JulioDev</summary>
      <platform>all</platform>
    </extension>
  </addon>
  <addon id="script.multi-user.management"
         name="Multi User Management"
         version="1.0.4"
         provider-name="MultiUser">

    <requires>
      <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <extension point="xbmc.python.script" library="default.py">
      <provides>executable</provides>
    </extension>

    <extension point="xbmc.service" library="service.py" start="startup" />

    <extension point="xbmc.addon.metadata">
      <summary>Gestión de múltiples cuentas de Trakt mediante tokens</summary>
      <platform>all</platform>
      <assets>
        <icon>icon.png</icon>
      </assets>
    </extension>

  </addon>
</addons>
